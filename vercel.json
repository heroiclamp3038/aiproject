{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/chat.py": { "maxDuration": 30 },
    "api/recover.py": { "maxDuration": 20 },
    "api/notify.py": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 12 * * *"
    }
  ]
}
