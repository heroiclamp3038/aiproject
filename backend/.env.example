# Required: Google Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Google service account credentials as a JSON string
# Copy the entire contents of your service_account.json, minified into one line
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optional: Your deployed frontend URL (e.g. https://fks-library.vercel.app)
# Defaults to allowing all origins if not set
FRONTEND_URL=https://your-frontend.vercel.app
